Options -MultiViews

RewriteEngine On

# Ne pas toucher aux fichiers/dossiers existants (api/, assets/, hub.php, manifest.json, ...)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# URL canonique sans slash final : /malcolm/ -> /malcolm (redirection 302, conserve la query string)
RewriteRule ^([a-z0-9-]+)/$ /$1 [R=302,L,QSA,NC]
RewriteRule ^([a-z0-9-]+)/([a-z0-9-]+)/$ /$1/$2 [R=302,L,QSA,NC]

# Deux segments type /malcolm/livres -> la liste, avec le contexte du hub de malcolm
RewriteRule ^([a-z0-9-]+)/([a-z0-9-]+)$ view.php?p=$1&l=$2 [L,QSA,NC]

# Un seul segment de chemin type /malcolm -> profile.php?slug=malcolm
RewriteRule ^([a-z0-9-]+)$ profile.php?slug=$1 [L,NC]

<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>
